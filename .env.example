# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER exposed to the client. Used for admin/server actions
# that must bypass RLS (e.g. admin writes validated by our own auth check).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the deployed app (used for metadata/OpenGraph/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
